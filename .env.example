# Everything is optional. With nothing set, the site runs and comments work in a demo (in-memory) mode.
VITE_SITE_URL=https://your-site.vercel.app

# Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543)
DATABASE_URL=

# Admin sign-in at /admin
ADMIN_PASSWORD=
SESSION_SECRET=
IP_HASH_SALT=

# Spam protection (free tiers: Cloudflare Turnstile, Upstash Redis)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
